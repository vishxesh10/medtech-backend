# Environment Variables Template
# Copy this and customize for your deployment platform

# ===== DATABASE =====
# Railway: Auto-generated when you add PostgreSQL
# For local dev: sqlite:///./prescriptions.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/medtech

# ===== JWT Configuration =====
JWT_SECRET_KEY=your-long-random-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== CORS Configuration =====
# For Vercel frontend: https://your-project.vercel.app
# For Netlify frontend: https://your-site.netlify.app
# For development: * or ["http://localhost:5173"]
CORS_ALLOW_ORIGINS=["*"]

# ===== Google Gemini API =====
# Required for prescription extraction
# Get key from: https://aistudio.google.com/apikey
GEMINI_KEY=

# ===== Optional: Hugging Face Token =====
# Only if using HF models
HF_TOKEN=

# ===== Optional: API Bearer Token =====
# For additional API protection layer
API_BEARER_TOKEN=

# ===== Application Information =====
APP_NAME=MedTech API
APP_DESCRIPTION=API for MedTech AI application
APP_VERSION=0.1.0
GEMINI_MODEL=gemini-2.5-flash
