# =========================================================
# MedTech AI Backend - Environment Configuration
# =========================================================

# Database Mode:
# 'memory'  -> Uses built-in mongomock (Zero setup needed! Great for running immediately)
# 'mongodb' -> Connects to local MongoDB or MongoDB Atlas
DATABASE_MODE=memory

# MongoDB Connection (Required only when DATABASE_MODE=mongodb)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=medtech

# JWT Authentication Secret & Algorithm
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (comma-separated origins allowed to talk to this backend)
CORS_ALLOW_ORIGINS=*

# Google Gemini API Key for Prescription OCR & Information Extraction
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Info
APP_NAME=MedTech API
APP_DESCRIPTION=AI-Powered Medical Prescription Digitizer and Management Backend
APP_VERSION=1.0.0
